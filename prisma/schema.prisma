generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Restaurant {
  id       Int      @id @default(autoincrement())
  name     String
  category String?
  rating   Float?
}

model User {
  id       Int    @id @default(autoincrement())
  name     String
  email    String @unique
  password String
}